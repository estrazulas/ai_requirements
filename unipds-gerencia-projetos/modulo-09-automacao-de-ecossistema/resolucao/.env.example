# Tokens de API
GITLAB_TOKEN=glpat-your-gitlab-token-here
GLPI_USER_TOKEN=your-glpi-user-token-here
GLPI_APP_TOKEN=your-glpi-app-token-here

# URLs (ajuste para seu ambiente)
GITLAB_URL=https://git.ifsc.edu.br
GLPI_URL=https://glpi.ifsc.edu.br/apirest.php

# Project ID do GitLab (número do projeto)
GITLAB_PROJECT_ID=123

# Configuração de IA para NL Parser (opcional)
# Provedor: openai ou anthropic
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# Chaves de API (configure pelo menos uma)
OPENAI_API_KEY=sk-your-openai-api-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
